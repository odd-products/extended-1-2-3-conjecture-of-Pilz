import WeightedPilz.CoefficientRank
import Mathlib.LinearAlgebra.Finsupp.Defs
import Mathlib.Algebra.MonoidAlgebra.NoZeroDivisors

/-! Scalar polynomial and Laurent convolution on vector coefficients, with
coefficientwise linear maps and the rank enhancement of scalar bounds. -/

noncomputable section
namespace WeightedPilz
open scoped BigOperators

variable {Γ K V W : Type*} [AddCommMonoid Γ] [Field K]
  [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]

def coefficientMap (φ : V →ₗ[K] W) : (Γ →₀ V) →ₗ[K] (Γ →₀ W) :=
  Finsupp.mapRange.linearMap φ

@[simp] theorem coefficientMap_apply (φ : V →ₗ[K] W) (H : Γ →₀ V) (a : Γ) :
    coefficientMap φ H a = φ (H a) := rfl

/-- Multiplication by a scalar polynomial, defined on arbitrary vector
coefficients without imposing a multiplication on the coefficient space. -/
def vectorMul (P : AddMonoidAlgebra K Γ) : (Γ →₀ V) →ₗ[K] (Γ →₀ V) :=
  ∑ a ∈ P.support, P a • Finsupp.lmapDomain V K (a + ·)

theorem vectorMul_apply (P : AddMonoidAlgebra K Γ) (H : Γ →₀ V) :
    vectorMul P H = ∑ a ∈ P.support, P a • Finsupp.mapDomain (a + ·) H := by
  simp only [vectorMul, LinearMap.sum_apply, LinearMap.smul_apply, Finsupp.lmapDomain_apply]

theorem coefficientMap_mapDomain (φ : V →ₗ[K] W) (f : Γ → Γ) (H : Γ →₀ V) :
    coefficientMap φ (Finsupp.mapDomain f H) = Finsupp.mapDomain f (coefficientMap φ H) :=
  (Finsupp.mapDomain_mapRange f H φ φ.map_zero φ.map_add).symm

/-- Coefficient projections commute with scalar multiplication. -/
theorem coefficientMap_vectorMul (φ : V →ₗ[K] W) (P : AddMonoidAlgebra K Γ)
    (H : Γ →₀ V) :
    coefficientMap φ (vectorMul P H) = vectorMul P (coefficientMap φ H) := by
  simp only [vectorMul_apply, map_sum, map_smul, coefficientMap_mapDomain]

theorem vectorMul_scalar (P H : AddMonoidAlgebra K Γ) : vectorMul P H = P * H := by
  classical
  simp only [vectorMul_apply, Finsupp.mapDomain, Finsupp.sum, Finset.smul_sum,
    Finsupp.smul_single, smul_eq_mul, AddMonoidAlgebra.mul_def]

theorem coefficientMap_vectorMul_scalar (φ : V →ₗ[K] K)
    (P : AddMonoidAlgebra K Γ) (H : Γ →₀ V) :
    coefficientMap φ (vectorMul P H) =
      (let h : AddMonoidAlgebra K Γ := coefficientMap φ H; P * h) := by
  exact (coefficientMap_vectorMul φ P H).trans (vectorMul_scalar P (coefficientMap φ H))

/-- Scalar multiplication is injective on vector coefficients whenever it
is injective on scalar coefficients. -/
theorem vectorMul_injective (P : AddMonoidAlgebra K Γ)
    (hP : Function.Injective (fun h : AddMonoidAlgebra K Γ ↦ P * h)) :
    Function.Injective (vectorMul (V := V) P) := by
  intro H J h
  ext a
  apply sub_eq_zero.mp
  apply (Module.forall_dual_apply_eq_zero_iff K (H a - J a)).mp
  intro φ
  have hφ := congrArg (coefficientMap φ) h
  simp only [coefficientMap_vectorMul_scalar] at hφ
  have ha := congrArg (fun f : Γ →₀ K ↦ f a) (hP hφ)
  simpa only [coefficientMap_apply, map_sub] using sub_eq_zero.mpr ha

theorem vectorMul_ne_zero (P : AddMonoidAlgebra K Γ)
    (hP : Function.Injective (fun h : AddMonoidAlgebra K Γ ↦ P * h))
    (H : Γ →₀ V) (hH : H ≠ 0) : vectorMul P H ≠ 0 := by
  intro hz
  exact hH (vectorMul_injective P hP (by simpa only [map_zero] using hz))

theorem vectorMul_coefficientRank_bound (P : AddMonoidAlgebra K Γ)
    (N : ℕ) (hbound : ∀ h : AddMonoidAlgebra K Γ, h ≠ 0 → N ≤ (P * h).support.card)
    (H : Γ →₀ V) (hG : vectorMul P H ≠ 0) :
    N + Module.finrank K (coefficientSpan (K := K) (vectorMul P H)) ≤
      (vectorMul P H).support.card + 1 := by
  apply coefficientRank_projection_bound _ hG N
  intro φ hφ
  change N ≤ (coefficientMap φ (vectorMul P H)).support.card
  rw [coefficientMap_vectorMul_scalar]
  apply hbound
  intro hz
  apply hφ
  change coefficientMap φ (vectorMul P H) = 0
  rw [coefficientMap_vectorMul_scalar, hz, mul_zero]

/-- Embed scalar coefficients in the line generated by a fixed vector. -/
def coefficientEmbed (v : V) : (Γ →₀ K) →ₗ[K] (Γ →₀ V) :=
  coefficientMap (LinearMap.id.smulRight v)

@[simp] theorem coefficientEmbed_apply (v : V) (h : Γ →₀ K) (a : Γ) :
    coefficientEmbed v h a = h a • v := rfl

theorem vectorMul_coefficientEmbed (P : AddMonoidAlgebra K Γ) (v : V)
    (h : AddMonoidAlgebra K Γ) :
    vectorMul P (coefficientEmbed v h) = coefficientEmbed v (P * h) := by
  rw [coefficientEmbed, ← coefficientMap_vectorMul, vectorMul_scalar]

theorem coefficientEmbed_injective (v : V) (hv : v ≠ 0) :
    Function.Injective (coefficientEmbed (Γ := Γ) (K := K) v) := by
  intro h g heq
  ext a
  have h := congrArg (fun f : Γ →₀ V ↦ f a) heq
  exact (smul_left_injective K hv) h

theorem support_coefficientEmbed (v : V) (hv : v ≠ 0) (h : Γ →₀ K) :
    (coefficientEmbed v h).support = h.support := by
  classical
  ext a
  simp only [Finsupp.mem_support_iff, coefficientEmbed_apply]
  constructor
  · intro hn hz
    exact hn (by rw [hz, zero_smul])
  · intro hn hz
    exact hn ((smul_eq_zero.mp hz).resolve_right hv)

/-- Absorb the scalar of a monomial into the nonzero coefficient vector. -/
theorem coefficientEmbed_single_mul (v : V) (d : Γ) (c : K)
    (Q : AddMonoidAlgebra K Γ) :
    coefficientEmbed v (AddMonoidAlgebra.single d c * Q) =
      coefficientEmbed (c • v) (AddMonoidAlgebra.single d (1 : K) * Q) := by
  have hsingle : AddMonoidAlgebra.single d c =
      c • (AddMonoidAlgebra.single d (1 : K)) := by simp
  rw [hsingle, smul_mul_assoc]
  ext a
  simp only [coefficientEmbed_apply, AddMonoidAlgebra.coeff_smul, smul_eq_mul, smul_smul]
  rw [mul_comm c]

/-- A normalized functional supplies a scalar preimage of every vector
polynomial lying in a single coefficient line. -/
theorem exists_normalized_dual (v : V) (hv : v ≠ 0) : ∃ φ : V →ₗ[K] K, φ v = 1 := by
  have hx : ¬ ∀ φ : V →ₗ[K] K, φ v = 0 := by
    simpa only [Module.forall_dual_apply_eq_zero_iff] using hv
  push_neg at hx
  obtain ⟨φ, hφ⟩ := hx
  refine ⟨(φ v)⁻¹ • φ, ?_⟩
  simp [hφ]

theorem coefficientEmbed_coefficientMap_of_factor (v : V) (φ : V →ₗ[K] K)
    (hφ : φ v = 1) (h : Γ →₀ K) :
    coefficientEmbed v (coefficientMap φ (coefficientEmbed v h)) = coefficientEmbed v h := by
  ext a
  simp [hφ]

/-- If a nonzero scalar multiple lies in one coefficient line, its cofactor
lies in that same line. -/
theorem vectorMul_factor_of_output_factor (P : AddMonoidAlgebra K Γ)
    (hP : Function.Injective (fun h : AddMonoidAlgebra K Γ ↦ P * h))
    (H : Γ →₀ V) (v : V) (φ : V →ₗ[K] K) (hφ : φ v = 1)
    (g : Γ →₀ K) (hG : vectorMul P H = coefficientEmbed v g) :
    H = coefficientEmbed v (coefficientMap φ H) := by
  apply vectorMul_injective P hP
  rw [vectorMul_coefficientEmbed, ← coefficientMap_vectorMul_scalar, hG]
  exact (coefficientEmbed_coefficientMap_of_factor v φ hφ g).symm

end WeightedPilz
