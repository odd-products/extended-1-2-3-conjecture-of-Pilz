import WeightedPilz.ModuleActions
import Mathlib.Algebra.Module.LocalizedModule.Basic

/-!
Localization reduction for injective scalar weights. The support bound on the
localized module is an explicit premise; this file proves the faithful change
of coefficients and that the active weights become units.
-/

namespace WeightedPilz

variable {R M : Type*} [CommRing R] [AddCommMonoid M] [Module R M]

/-- The multiplicative set generated by the active interval weights. -/
def intervalWeightSubmonoid (n : ℕ) (c : ℕ → R) : Submonoid R :=
  Submonoid.closure (c '' {a | 1 ≤ a ∧ a ≤ n})

theorem intervalWeight_mem (n : ℕ) (c : ℕ → R) {a : ℕ}
    (ha : 1 ≤ a) (han : a ≤ n) : c a ∈ intervalWeightSubmonoid n c :=
  Submonoid.subset_closure ⟨a, ⟨ha, han⟩, rfl⟩

/-- A product of zero-reflecting active weights still reflects zero. -/
theorem intervalWeightSubmonoid_reflectsZero (n : ℕ) (c : ℕ → R)
    (hc : ∀ a, 1 ≤ a → a ≤ n → ReflectsZero (scalarWeightEnd (M := M) (c a)))
    {r : R} (hr : r ∈ intervalWeightSubmonoid n c) :
    ∀ x : M, r • x = 0 → x = 0 := by
  induction hr using Submonoid.closure_induction with
  | mem r hr =>
      obtain ⟨a, ⟨ha, han⟩, rfl⟩ := hr
      exact hc a ha han
  | one =>
      intro x hx
      simpa only [one_smul] using hx
  | mul r s hr hs ihr ihs =>
      intro x hx
      apply ihs x
      apply ihr (s • x)
      simpa only [mul_smul] using hx

/-- Localizing at zero-reflecting scalars does not kill a nonzero coefficient. -/
theorem localizedModule_reflectsZero (S : Submonoid R)
    (hS : ∀ r ∈ S, ∀ x : M, r • x = 0 → x = 0) :
    ∀ x, LocalizedModule.mkLinearMap S M x = 0 → x = 0 := by
  intro x hx
  obtain ⟨r, hr, hkill⟩ :=
    (LocalizedModule.mem_ker_mkLinearMap_iff (S := S) (m := x)).mp hx
  exact hS r hr x hkill

/-- Exact support preservation for the generated localization. -/
theorem support_intervalWeight_localization (n : ℕ) (c : ℕ → R)
    (hc : ∀ a, 1 ≤ a → a ≤ n → ReflectsZero (scalarWeightEnd (M := M) (c a)))
    {α : Type*} (f : α →₀ M) :
    (Finsupp.mapRange (LocalizedModule.mkLinearMap (intervalWeightSubmonoid n c) M)
      (map_zero _) f).support = f.support := by
  apply support_mapRange_of_zeroReflecting
    (LocalizedModule.mkLinearMap (intervalWeightSubmonoid n c) M).toAddMonoidHom
  exact localizedModule_reflectsZero _ (fun _ hr => intervalWeightSubmonoid_reflectsZero n c hc hr)

/-- Each active weight becomes a unit in the localization ring. -/
theorem isUnit_intervalWeight_localization (n : ℕ) (c : ℕ → R) {a : ℕ}
    (ha : 1 ≤ a) (han : a ≤ n) :
    IsUnit (algebraMap R (Localization (intervalWeightSubmonoid n c)) (c a)) :=
  IsLocalization.map_units _ ⟨c a, intervalWeight_mem n c ha han⟩

/-- The localized scalar action commutes with the coefficient inclusion. -/
theorem intervalEndAction_localization (n : ℕ) (c : ℕ → R) (f : ℕ+ →₀ M) :
    Finsupp.mapRange (LocalizedModule.mkLinearMap (intervalWeightSubmonoid n c) M)
      (map_zero _) (intervalEndAction n (fun a => scalarWeightEnd (c a)) f) =
      intervalEndAction n
        (fun a => scalarWeightEnd
          (algebraMap R (Localization (intervalWeightSubmonoid n c)) (c a)))
        (Finsupp.mapRange (LocalizedModule.mkLinearMap (intervalWeightSubmonoid n c) M)
          (map_zero _) f) := by
  apply intervalEndAction_naturality n _ _
    (LocalizedModule.mkLinearMap (intervalWeightSubmonoid n c) M).toAddMonoidHom
  intro a ha x
  change LocalizedModule.mkLinearMap _ M (c (a + 1) • x) = _
  rw [map_smul]
  exact (algebraMap_smul (Localization (intervalWeightSubmonoid n c)) (c (a + 1)) _).symm

/-- A bound for unit weights after localization gives the original bound when
every active scalar reflects zero. -/
theorem intervalEndBound_of_localization (n : ℕ) (c : ℕ → R)
    (hc : ∀ a, 1 ≤ a → a ≤ n → ReflectsZero (scalarWeightEnd (M := M) (c a)))
    (hbound : IntervalEndBound (M := LocalizedModule (intervalWeightSubmonoid n c) M) n
      (fun a => scalarWeightEnd
        (algebraMap R (Localization (intervalWeightSubmonoid n c)) (c a)))) :
    IntervalEndBound (M := M) n (fun a => scalarWeightEnd (c a)) := by
  apply intervalEndBound_of_zeroReflecting_intertwiner n _
    (fun a => scalarWeightEnd (M := LocalizedModule (intervalWeightSubmonoid n c) M)
      (algebraMap R (Localization (intervalWeightSubmonoid n c)) (c a)))
    (LocalizedModule.mkLinearMap (intervalWeightSubmonoid n c) M).toAddMonoidHom
  · exact localizedModule_reflectsZero _
      (fun _ hr => intervalWeightSubmonoid_reflectsZero n c hc hr)
  · intro a ha x
    change LocalizedModule.mkLinearMap _ M (c (a + 1) • x) = _
    rw [map_smul]
    exact (algebraMap_smul (Localization (intervalWeightSubmonoid n c)) (c (a + 1)) _).symm
  · exact hbound

end WeightedPilz
