import Pilz.FreshAlgebraMaps
import Mathlib.Algebra.CharP.Two
import Mathlib.Algebra.Field.ZMod
import Mathlib.Algebra.MvPolynomial.CommRing
import Mathlib.Algebra.Polynomial.RingDivision
import Mathlib.RingTheory.MvPolynomial.Basic

/-!
# The prime fresh-linear polynomial

This file checks the algebraic basic facts in the paper's fresh-variable
descent. Every fresh variable occurs once and linearly, and the nonzero core
is independent of all fresh variables.
-/

noncomputable section

namespace Pilz

open scoped BigOperators

/-- The setting of Section 3, with explicitly identified fresh variables. -/
structure FreshData where
  vars : Finset ℕ
  nonempty : vars.Nonempty
  C : Poly
  C_ne_zero : C ≠ 0
  independent : ∀ z ∈ vars, IndependentOf C z

namespace FreshData

/-- Sum of the fresh variables. -/
def freshSum (S : FreshData) : Poly := ∑ z ∈ S.vars, MvPolynomial.X z

/-- The fresh-linear polynomial `C + Z`. -/
def F (S : FreshData) : Poly := S.C + S.freshSum

/-- The terms remaining when one chosen fresh variable is removed. -/
def rest (S : FreshData) (z : ℕ) : Poly :=
  S.C + ∑ i ∈ S.vars.erase z, MvPolynomial.X i

theorem F_eq_X_add_rest (S : FreshData) {z : ℕ} (hz : z ∈ S.vars) :
    S.F = MvPolynomial.X z + S.rest z := by
  rw [F, freshSum, rest, ← Finset.add_sum_erase _ _ hz]
  ac_rfl

private theorem variable_not_mem_vars {P : Poly} {z : ℕ}
    (hP : IndependentOf P z) : z ∉ P.vars := by
  intro hz
  obtain ⟨d, hd, hdz⟩ := (MvPolynomial.mem_vars z).mp hz
  exact (Finsupp.mem_support_iff.mp hdz) (hP d hd)

theorem rest_independent (S : FreshData) {z : ℕ} (hz : z ∈ S.vars) :
    IndependentOf (S.rest z) z := by
  intro d hd
  have hzC := variable_not_mem_vars (S.independent z hz)
  have hvars : z ∉ (S.rest z).vars := by
    intro hmem
    have hsubset := MvPolynomial.vars_add_subset S.C
      (∑ i ∈ S.vars.erase z, MvPolynomial.X i)
    have hparts := Finset.mem_union.mp (hsubset hmem)
    rcases hparts with hc | hs
    · exact hzC hc
    · have hsum := MvPolynomial.vars_sum_subset (S.vars.erase z)
        (fun i => (MvPolynomial.X i : Poly))
      have hbi := hsum hs
      simp only [Finset.mem_biUnion, MvPolynomial.vars_X, Finset.mem_singleton] at hbi
      obtain ⟨i, hi, hzi⟩ := hbi
      exact (Finset.mem_erase.mp hi).1 hzi.symm
  by_contra hdz
  exact hvars ((MvPolynomial.mem_vars z).mpr ⟨d, hd, Finsupp.mem_support_iff.mpr hdz⟩)

/-- The linear fresh polynomial is a prime element. -/
theorem prime_F (S : FreshData) : Prime S.F := by
  obtain ⟨z, hz⟩ := S.nonempty
  have himage : asUnivariate z S.F =
      Polynomial.X - Polynomial.C (-(S.rest z)) := by
    rw [S.F_eq_X_add_rest hz, map_add, asUnivariate_X, if_pos rfl,
      asUnivariate_of_independent z (S.rest z) (S.rest_independent hz)]
    simp
  apply comap_prime (asUnivariate z) (Polynomial.evalRingHom (MvPolynomial.X z))
    (fun P => eval_asUnivariate z P)
  rw [himage]
  exact Polynomial.prime_X_sub_C _

/-- Substitute the unique root in one chosen fresh variable. -/
def substitute (S : FreshData) (z : ℕ) : Poly →+* Poly :=
  MvPolynomial.eval₂Hom MvPolynomial.C
    (fun i => if i = z then S.rest z else MvPolynomial.X i)

@[simp] theorem substitute_X (S : FreshData) (z i : ℕ) :
    S.substitute z (MvPolynomial.X i) =
      if i = z then S.rest z else MvPolynomial.X i := by
  simp [substitute]

theorem substitute_eq_self_of_independent (S : FreshData) (z : ℕ) (P : Poly)
    (hP : IndependentOf P z) : S.substitute z P = P := by
  apply hom_eq_of_independent (S.substitute z) (RingHom.id Poly) z P hP
  · intro c
    simp [substitute]
  · intro i hi
    simp [hi]

@[simp] theorem substitute_C (S : FreshData) {z : ℕ} (hz : z ∈ S.vars) :
    S.substitute z S.C = S.C :=
  S.substitute_eq_self_of_independent z S.C (S.independent z hz)

@[simp] theorem substitute_F (S : FreshData) {z : ℕ} (hz : z ∈ S.vars) :
    S.substitute z S.F = 0 := by
  rw [S.F_eq_X_add_rest hz, map_add, substitute_X, if_pos rfl,
    S.substitute_eq_self_of_independent z (S.rest z) (S.rest_independent hz)]
  exact CharTwo.add_self_eq_zero _

theorem substitute_eq_eval_asUnivariate (S : FreshData) (z : ℕ) (P : Poly) :
    S.substitute z P = Polynomial.eval (S.rest z) (asUnivariate z P) := by
  have hh : S.substitute z =
      (Polynomial.evalRingHom (S.rest z)).comp (asUnivariate z) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp [substitute, asUnivariate]
    · intro i
      by_cases hi : i = z <;> simp [substitute, asUnivariate, hi]
  exact RingHom.congr_fun hh P

/-- The substitution kernel is precisely the principal ideal generated by F. -/
theorem dvd_F_iff_substitute_eq_zero (S : FreshData) {z : ℕ} (hz : z ∈ S.vars)
    (P : Poly) : S.F ∣ P ↔ S.substitute z P = 0 := by
  constructor
  · intro hdiv
    have hd := map_dvd (S.substitute z) hdiv
    simpa only [S.substitute_F hz, zero_dvd_iff] using hd
  · intro heval
    have himage : asUnivariate z S.F =
        Polynomial.X - Polynomial.C (S.rest z) := by
      rw [S.F_eq_X_add_rest hz, map_add, asUnivariate_X, if_pos rfl,
        asUnivariate_of_independent z (S.rest z) (S.rest_independent hz)]
      rw [CharTwo.sub_eq_add]
    have hdiv : asUnivariate z S.F ∣ asUnivariate z P := by
      rw [himage, Polynomial.dvd_iff_isRoot, Polynomial.IsRoot.def]
      exact (S.substitute_eq_eval_asUnivariate z P).symm.trans heval
    have hd := map_dvd (Polynomial.evalRingHom (MvPolynomial.X z)) hdiv
    simpa only [Polynomial.coe_evalRingHom, eval_asUnivariate] using hd

/-- Erase every fresh variable while retaining every other variable. -/
def erase (S : FreshData) : Poly →+* Poly :=
  MvPolynomial.eval₂Hom MvPolynomial.C
    (fun i => if i ∈ S.vars then 0 else MvPolynomial.X i)

@[simp] theorem erase_X (S : FreshData) (i : ℕ) :
    S.erase (MvPolynomial.X i) = if i ∈ S.vars then 0 else MvPolynomial.X i := by
  simp [erase]

@[simp] theorem erase_C (S : FreshData) : S.erase S.C = S.C := by
  apply MvPolynomial.hom_congr_vars
    (f₁ := S.erase) (f₂ := RingHom.id Poly) (p₁ := S.C) (p₂ := S.C)
  · ext c
    simp [erase]
  · intro i hi _
    have hnot : i ∉ S.vars := by
      intro hfresh
      exact variable_not_mem_vars (S.independent i hfresh) hi
    simp [hnot]
  · rfl

@[simp] theorem erase_rest (S : FreshData) (z : ℕ) : S.erase (S.rest z) = S.C := by
  simp only [rest, map_add, erase_C, map_sum]
  have hsum : ∑ i ∈ S.vars.erase z, S.erase (MvPolynomial.X i) = 0 := by
    apply Finset.sum_eq_zero
    intro i hi
    simp [(Finset.mem_erase.mp hi).2]
  rw [hsum, add_zero]

theorem rest_ne_zero (S : FreshData) (z : ℕ) : S.rest z ≠ 0 := by
  intro h
  have hh := S.erase_rest z
  rw [h, map_zero] at hh
  exact S.C_ne_zero hh.symm

theorem substitute_monomial_ne_zero (S : FreshData) (z : ℕ)
    (d : ℕ →₀ ℕ) {c : ZMod 2} (hc : c ≠ 0) :
    S.substitute z (MvPolynomial.monomial d c) ≠ 0 := by
  rw [substitute, MvPolynomial.eval₂Hom_monomial]
  apply mul_ne_zero
  · exact MvPolynomial.C_ne_zero.mpr hc
  · apply Finset.prod_ne_zero_iff.mpr
    intro i _
    apply pow_ne_zero
    by_cases hi : i = z
    · simp only [if_pos hi]
      exact S.rest_ne_zero z
    · simp only [if_neg hi]
      exact MvPolynomial.X_ne_zero i

/-- No nonzero monomial is divisible by the fresh-linear polynomial. -/
theorem not_dvd_monomial (S : FreshData) (d : ℕ →₀ ℕ)
    {c : ZMod 2} (hc : c ≠ 0) : ¬ S.F ∣ MvPolynomial.monomial d c := by
  obtain ⟨z, hz⟩ := S.nonempty
  exact fun h => S.substitute_monomial_ne_zero z d hc
    ((S.dvd_F_iff_substitute_eq_zero hz _).mp h)

@[simp] theorem substitute_freshSum (S : FreshData) {z : ℕ} (hz : z ∈ S.vars) :
    S.substitute z S.freshSum = S.C := by
  have hh := S.substitute_F hz
  rw [F, map_add, S.substitute_C hz] at hh
  exact (eq_neg_of_add_eq_zero_right hh).trans (CharTwo.neg_eq _)

/-- The sum of fresh variables is not divisible by F. -/
theorem not_dvd_freshSum (S : FreshData) : ¬ S.F ∣ S.freshSum := by
  obtain ⟨z, hz⟩ := S.nonempty
  intro h
  have hh := (S.dvd_F_iff_substitute_eq_zero hz _).mp h
  rw [S.substitute_freshSum hz] at hh
  exact S.C_ne_zero hh

private theorem X_add_X_ne_zero {i j : ℕ} (hij : i ≠ j) :
    (MvPolynomial.X i + MvPolynomial.X j : Poly) ≠ 0 := by
  intro h
  have heq : (MvPolynomial.X i : Poly) = MvPolynomial.X j := by
    exact (eq_neg_of_add_eq_zero_left h).trans (CharTwo.neg_eq _)
  exact hij (MvPolynomial.X_injective heq)

/-- A sum of two distinct fresh variables is not divisible by F. -/
theorem not_dvd_X_add_X (S : FreshData) {i j : ℕ}
    (hi : i ∈ S.vars) (hj : j ∈ S.vars) (hij : i ≠ j) :
    ¬ S.F ∣ (MvPolynomial.X i + MvPolynomial.X j) := by
  intro h
  have hh := (S.dvd_F_iff_substitute_eq_zero hi _).mp h
  rw [map_add, substitute_X, substitute_X, if_pos rfl, if_neg hij.symm] at hh
  have he := congrArg S.erase hh
  simp only [map_add, erase_rest, erase_X, if_pos hj, add_zero, map_zero] at he
  exact S.C_ne_zero he

end FreshData
end Pilz
